{
  "name": "sentrix",
  "productName": "Sentrix",
  "version": "0.1.0",
  "description": "Sentrix: a local-only, encrypted password manager. No cloud, no accounts, no servers.",
  "license": "MIT",
  "author": "Sentrix contributors",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "pack:extension": "node scripts/pack-extension.mjs"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "hash-wasm": "^4.13.0",
    "otpauth": "^9.6.0",
    "tldts": "^7.4.21",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zion07740/sentrix"
  },
  "engines": {
    "node": ">=22"
  }
}
